# Site configuration. Copy this file to config/local.env and edit the paths.
# env.sh reads config/local.env. Keep config/local.env out of version control.
# Relative paths are relative to the repository root.
# A value already set in the shell wins over the value in this file.

# Root directory for model weights, caches and temporary files.
# Use a disk with space for approximately 40 GB of weights and caches.
RLM_STORAGE_ROOT=storage

# Model weights. The serving script looks for
# $MODELS_DIR/unsloth_Qwen3.8-27B-FP8 (see scripts/download_model.py).
MODELS_DIR=storage/models

# The frozen Wikidata graph (the output of the build scripts).
WIKIDATA_GRAPH_DIR=data/graph

# Raw inputs of the build scripts. Only needed to rebuild the graph.
# WIKIDATA_FORMATTED_SOURCE=data/raw/wikidata_formatted
# WIKIDATA_EXTRACTED_SOURCE=data/raw/wikidata_extracted
# WIKIDATA_HF_RANKS_SOURCE=data/hf_ranks

# OpenAI-compatible endpoint. The defaults match scripts/serve/serve_vllm.sh
# on the same machine. A local vLLM server accepts any non-empty API_KEY.
VLLM_HOST=127.0.0.1
VLLM_PORT=8000
# BASE_URL=http://127.0.0.1:8000/v1
API_KEY=EMPTY
MODEL_NAME=Qwen3.8-27B-FP8
# SUBQ_MODEL_NAME=Qwen3.8-27B-FP8

# Python interpreter for the harness. Default: .venv/bin/python when it
# exists, else python3.
# PYTHON=.venv/bin/python

# Gated Hugging Face repositories need HF_TOKEN. Set it in the shell only.
# Do not write a token into this file.
