# Reference configuration: the settings of the published 56-task results.
#
# env.sh loads this file. A value already set in the shell wins, so a single
# command can override one setting:
#   RLM_REASONING_EFFORT=medium bash scripts/run_reference.sh
# Every run records the settings it used under `generation` in metadata.json,
# and every batch records them in batch.json.

# --- Root model generation -------------------------------------------------
RLM_ENABLE_THINKING=1
RLM_REASONING_EFFORT=low
RLM_TEMPERATURE=0
RLM_TOP_P=0.95
RLM_TOP_K=20
RLM_MAX_TOKENS=32768

# --- Harness ----------------------------------------------------------------
# llm_map: batched delegation of semantic judgement to sub-queries.
RLM_LLM_MAP=1
# Explain an empty name search (which word matched nothing).
RLM_SEARCH_HINTS=1
# Optional answer guard; not part of the reference configuration.
RLM_FINAL_GUARD=0
# Whole-run cap on sub-queries (llm_query and llm_map batches).
SUBQ_LIMIT=80
# Concurrent task subprocesses. 1 runs the tasks one after another.
WORKERS=1

# --- vLLM server (scripts/serve/serve_vllm.sh) ------------------------------
MAX_MODEL_LEN=131072
MAX_NUM_SEQS=8
GPU_MEMORY_UTILIZATION=0.90
KV_CACHE_DTYPE=fp8
REASONING_PARSER=qwen3
MTP_TOKENS=3
